# 后端配置示意（不是生产配置，也没有任何真实凭据）。
# 复制为 backend/.env 后按需修改；.env 已被 .gitignore 忽略。

APP_ENV=development
# PostgreSQL；本机无 Docker 时可用本地集群，例如：
# postgresql+psycopg://mockmate@127.0.0.1:55432/mockmate
DATABASE_URL=
SESSION_TTL_DAYS=7
PRIVATE_FILE_ROOT=./runtime/private

# disabled | deepseek | test
# test 只能在 ALLOW_TEST_FIXTURES=true 且非生产环境使用，输出带 test_only 标记
AI_PROVIDER=disabled
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=60

MAX_UPLOAD_BYTES=10485760
MAX_MATERIAL_CHARACTERS=20000
MAX_JOB_ATTEMPTS=2

# 生产环境必须为 false；test 模式必需 true
ALLOW_TEST_FIXTURES=false

# 开发样板岗位：开启后 java-backend 以 sample_only=true 启用，界面需醒目标注
M1_SAMPLE_CATALOG=false

LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOG_LEVEL=INFO

# M3 speech provider: disabled | deepseek | test
# deepseek may explicitly inherit AI_API_KEY only when AI_PROVIDER=deepseek.
SPEECH_PROVIDER=disabled
SPEECH_BASE_URL=https://api.deepseek.com
SPEECH_API_KEY=
TTS_VOICE_ID=stella
SPEECH_TIMEOUT_SECONDS=60
VOICE_MAX_ANSWER_SECONDS=120
VOICE_SAMPLE_RATE=16000
AUDIO_RETENTION_HOURS=24
SPEECH_ADAPTER_VERSION=deepseek-speech-v1
